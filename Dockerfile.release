# Multi-arch image from prebuilt static binaries (used by the image
# workflow). The binaries are built natively per architecture, so no
# emulated Rust build is needed.
#
#   dist/linux/amd64/nandi
#   dist/linux/arm64/nandi
#   dist/data/            (empty directory, becomes /var/lib/nandi)

FROM scratch
ARG TARGETPLATFORM
COPY dist/${TARGETPLATFORM}/nandi /usr/local/bin/nandi
COPY --chown=65532:65532 dist/data/ /var/lib/nandi/
COPY dist/data/ /etc/nandi/
USER 65532:65532
ENV NANDI_CONFIG=/etc/nandi/nandi.yaml
EXPOSE 8787 8788
VOLUME ["/var/lib/nandi"]
ENTRYPOINT ["/usr/local/bin/nandi"]
CMD ["run", "-c", "/etc/nandi/nandi.yaml"]
