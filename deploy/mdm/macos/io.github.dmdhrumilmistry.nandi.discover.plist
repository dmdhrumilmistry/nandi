<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reports this user's AI footprint (agents, MCP servers, hooks, skills) to
  the central nandi at login and every 6 hours (install in
  /Library/LaunchAgents). The target comes from the managed `report`
  settings (url and report token).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.dmdhrumilmistry.nandi.discover</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec /usr/local/bin/nandi discover --report -c "$HOME/.config/nandi/nandi.yaml" &gt;/dev/null 2&gt;&gt;"$HOME/Library/Logs/nandi-discover.log"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
